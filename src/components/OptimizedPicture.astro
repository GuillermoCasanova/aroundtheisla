---
/**
 * OptimizedPicture
 * Local imports go through astro:assets (Sharp at build). Sanity CDN
 * URLs stay on cdn.sanity.io with a width srcset — no build-time fetch.
 * Optional `srcMobile` art-directs a taller crop below 768px via `<picture>`.
 */
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import {
  cmsFallbackSrc,
  cmsSrcset,
  isSanityCdnUrl,
} from "../lib/cms-image";

interface Props {
  src: ImageMetadata | string;
  alt: string;
  /** Intrinsic pixel size — required for remote/CMS URLs (CLS). */
  width?: number;
  height?: number;
  /**
   * Optional taller crop for viewports below `desktopMedia`.
   * CMS URLs only — renders a `<picture>` so only one file downloads.
   */
  srcMobile?: string;
  widthMobile?: number;
  heightMobile?: number;
  /** Viewport at which `src` (desktop) takes over. */
  desktopMedia?: string;
  widths?: number[];
  sizes?: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  decoding?: "async" | "sync" | "auto";
  quality?: number;
  class?: string;
  /** Forwarded to the inner <img> so ImageLoader can bind load listeners. */
  "data-image-loader-img"?: boolean | "";
}

const {
  src,
  alt,
  width,
  height,
  srcMobile,
  widthMobile,
  heightMobile,
  desktopMedia = "(min-width: 768px)",
  widths,
  sizes,
  loading = "lazy",
  fetchpriority,
  decoding = "async",
  quality = 70,
  class: className,
  "data-image-loader-img": dataImageLoaderImg,
} = Astro.props;

const isAsset = typeof src !== "string";
const intrinsicWidth = width ?? 1600;
const intrinsicHeight = height ?? 1200;
const sanitySrc = !isAsset && isSanityCdnUrl(src) ? src : null;
const sanitySrcMobile =
  srcMobile && isSanityCdnUrl(srcMobile) && srcMobile !== sanitySrc
    ? srcMobile
    : null;
const artDirected = Boolean(sanitySrc && sanitySrcMobile);
const mobileWidth = widthMobile ?? intrinsicWidth;
const mobileHeight = heightMobile ?? intrinsicHeight;
const pictureSizes = sizes ?? "100vw";
---

{
  isAsset ? (
    <Picture
      src={src}
      alt={alt}
      class={className}
      widths={widths}
      sizes={sizes}
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={quality}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding={decoding}
      data-image-loader-img={dataImageLoaderImg}
    />
  ) : artDirected && sanitySrc && sanitySrcMobile ? (
    <picture>
      <source
        media={desktopMedia}
        srcset={cmsSrcset(sanitySrc, widths, intrinsicWidth, quality)}
        sizes={pictureSizes}
      />
      <img
        src={cmsFallbackSrc(sanitySrcMobile, widths, mobileWidth, quality)}
        srcset={cmsSrcset(sanitySrcMobile, widths, mobileWidth, quality)}
        sizes={pictureSizes}
        width={mobileWidth}
        height={mobileHeight}
        alt={alt}
        class={className}
        loading={loading}
        fetchpriority={fetchpriority}
        decoding={decoding}
        data-image-loader-img={dataImageLoaderImg}
      />
    </picture>
  ) : (
    <img
      src={
        sanitySrc
          ? cmsFallbackSrc(sanitySrc, widths, intrinsicWidth, quality)
          : src
      }
      srcset={
        sanitySrc
          ? cmsSrcset(sanitySrc, widths, intrinsicWidth, quality)
          : undefined
      }
      sizes={sanitySrc ? pictureSizes : sizes}
      width={intrinsicWidth}
      height={intrinsicHeight}
      alt={alt}
      class={className}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding={decoding}
      data-image-loader-img={dataImageLoaderImg}
    />
  )
}
