---
/**
 * OptimizedPicture
 * Local imports go through astro:assets (Sharp at build). Sanity CDN
 * URLs stay on cdn.sanity.io with a width srcset — no build-time fetch.
 */
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import {
  cmsFallbackSrc,
  cmsSrcset,
  isSanityCdnUrl,
} from "../lib/cms-image";

interface Props {
  src: ImageMetadata | string;
  alt: string;
  /** Intrinsic pixel size — required for remote/CMS URLs (CLS). */
  width?: number;
  height?: number;
  widths?: number[];
  sizes?: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  decoding?: "async" | "sync" | "auto";
  quality?: number;
  class?: string;
  /** Forwarded to the inner <img> so ImageLoader can bind load listeners. */
  "data-image-loader-img"?: boolean | "";
}

const {
  src,
  alt,
  width,
  height,
  widths,
  sizes,
  loading = "lazy",
  fetchpriority,
  decoding = "async",
  quality = 70,
  class: className,
  "data-image-loader-img": dataImageLoaderImg,
} = Astro.props;

const isAsset = typeof src !== "string";
const intrinsicWidth = width ?? 1600;
const intrinsicHeight = height ?? 1200;
const sanitySrc = !isAsset && isSanityCdnUrl(src) ? src : null;
---

{
  isAsset ? (
    <Picture
      src={src}
      alt={alt}
      class={className}
      widths={widths}
      sizes={sizes}
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={quality}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding={decoding}
      data-image-loader-img={dataImageLoaderImg}
    />
  ) : (
    <img
      src={
        sanitySrc
          ? cmsFallbackSrc(sanitySrc, widths, intrinsicWidth, quality)
          : src
      }
      srcset={
        sanitySrc
          ? cmsSrcset(sanitySrc, widths, intrinsicWidth, quality)
          : undefined
      }
      sizes={sanitySrc ? (sizes ?? "100vw") : sizes}
      width={intrinsicWidth}
      height={intrinsicHeight}
      alt={alt}
      class={className}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding={decoding}
      data-image-loader-img={dataImageLoaderImg}
    />
  )
}
