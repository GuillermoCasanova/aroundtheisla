---
/**
 * SectionProject
 * Project detail from Figma `268:152` ("Single Project View").
 *
 * Vertical photograph stack with a sticky left rail: back-to-Work, title
 * and Small / Medium / Large under it (desktop only), description pinned
 * to the bottom left. Dedicated credits sit after the photographs.
 * Full-bleed by design — no SectionMain column / side rules (same deviation
 * as SectionHomeSlideshow): the Figma frame is edge-to-edge editorial.
 *
 * `ProjectSize` sets the photo-stack container width (25 / 40 / 60rem)
 * and scales the gap — desktop only. Below `lg`, photographs are 100%
 * of the frame and ignore `data-size`. Preference persists in
 * localStorage. Reduced motion: width and gap changes are instant.
 */
import type { ImageMetadata } from "astro";
import ImageLoader from "@components/ImageLoader.astro";
import ProjectSize from "@components/ProjectSize.astro";
import { isCmsImage, type CmsImage } from "../lib/cms-image";

type Photo = ImageMetadata | CmsImage;

export type RelatedProject = {
  title: string;
  year: number;
  href: string;
  cover: Photo;
};

interface Props {
  title: string;
  description: string;
  /** Credit list shown under "Project Credits". Falls back to description. */
  credits?: string;
  /** Cover still — used when the gallery is empty. */
  cover: Photo;
  coverAlt?: string;
  gallery?: Photo[];
  /** Other projects shown as a thumbnail grid after credits. */
  related?: RelatedProject[];
  class?: string;
}

const {
  title,
  description,
  credits,
  cover,
  coverAlt,
  gallery = [],
  related = [],
  class: className,
} = Astro.props;

const images = gallery.length > 0 ? gallery : [cover];
const resolvedCoverAlt =
  coverAlt ?? (isCmsImage(cover) ? cover.alt : `${title} cover photograph`);
const railCopy = description.trim();
const footerCredits = (credits ?? "").trim();

function photoCaption(image: Photo): string | undefined {
  return isCmsImage(image) ? image.caption : undefined;
}
---

{
  /*
   * Full-bleed editorial frame — allowed deviation from SectionMain: the
   * Figma singleton is an edge-to-edge vertical gallery; the shared column
   * and side rules would inset the photographs and fight the sticky rail.
   */
}
<section
  id="project-gallery"
  data-project
  data-size="large"
  aria-label={`${title} photographs`}
  class:list={["relative bg-canvas text-fg section-pt-sm", className]}
>
  <div data-project-frame>
    <header data-project-rail class="md:section-pt-xs md:pb-6">
      <div data-project-rail-top>
        <p class="inline-flex min-h-11 items-center">
          <a
            href="/work"
            class="group inline-flex min-h-11 items-center gap-2 text-body-lg font-bold text-fg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
          >
            <svg
              class="h-3 w-2 shrink-0"
              viewBox="0 0 8 13"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M7 1L1.5 6.5L7 12"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="square"></path>
            </svg>
            <span class="group-hover:underline underline-offset-2">Work</span>
          </a>
        </p>

        <div data-project-rail-heading>
          <h1
            class="min-w-0 break-words font-heading text-[clamp(1.75rem,4vw,2.5rem)] leading-none font-bold tracking-tight text-fg"
          >
            {title}
          </h1>
          <ProjectSize class="max-lg:hidden" />
        </div>
      </div>

      {
        railCopy && (
          <p
            data-project-copy
            class="text-[0.72rem] leading-normal font-light whitespace-pre-line text-secondary"
          >
            {railCopy}
          </p>
        )
      }
    </header>

    <div data-project-photos class="min-w-0">
      {
        images.map((image, i) => {
          const caption = photoCaption(image);
          return (
            <figure data-project-photo class="relative m-0 w-full">
              <ImageLoader
                src={isCmsImage(image) ? image.src : image}
                alt={
                  i === 0 ? resolvedCoverAlt : `${title} — photograph ${i + 1}`
                }
                width={image.width}
                height={image.height}
                class="w-full"
                imgClass="block h-auto w-full"
                widths={[480, 720, 960, 1280, 1600, 2000]}
                sizes="(max-width: 768px) calc(100vw - 2.5rem), min(60rem, calc(100vw - 20.75rem))"
                loading={i === 0 ? "eager" : "lazy"}
                fetchpriority={i === 0 ? "high" : undefined}
                decoding={i === 0 ? "sync" : "async"}
                stage={i !== 0}
                placeholder={isCmsImage(image) ? image.lqip : undefined}
              />
              {caption && (
                <figcaption class="mt-3 max-w-[10.5rem] text-body-sm leading-normal text-fg/30 xl:absolute xl:right-0 xl:bottom-0 xl:mt-0 xl:translate-x-[calc(100%+(var(--spacing)*5))]">
                  {caption}
                </figcaption>
              )}
            </figure>
          );
        })
      }
    </div>
  </div>

  {
    footerCredits && (
      <footer data-project-credits class="flex w-full flex-col items-center">
        <div class="flex w-full max-w-[25.3rem] flex-col items-center text-center">
          <h2 class="text-body-sm font-normal text-fg">Project Credits</h2>
          <p class="mt-4 text-[0.72rem] leading-normal font-light whitespace-pre-line text-fg">
            {footerCredits}
          </p>
        </div>
        <div
          class="mt-[clamp(calc(var(--spacing)*16),10vw,calc(var(--spacing)*30))] h-px w-5 bg-fg"
          aria-hidden="true"
        />
      </footer>
    )
  }
</section>

<style>
  /* Figma 268:152 — 352 / 520 / 732 at a 1440 artboard. data-size is
     desktop-only: below lg the stack is 100% wide and the scale tokens
     do not apply, even if localStorage still holds a size. Keep the
     size rules unhashed so width and gap flip together at lg
     (see components.styling). */
  :global([data-project]) {
    --project-pad: clamp(
      calc(var(--spacing) * 5),
      2.5vw,
      calc(var(--spacing) * 6.5)
    );
    --project-rail: 16rem;
    --project-rail-gap: calc(var(--spacing) * 6);
    --project-left-min: calc(var(--project-rail) + var(--project-rail-gap));
    --project-photo-width: 100%;
    --project-photo-scale: 1;
    --project-photo-gap: clamp(
      calc(var(--spacing) * 16),
      10vw,
      calc(var(--spacing) * 28)
    );
  }

  @media (min-width: 1024px) {
    :global([data-project]) {
      --project-photo-width: min(45.75rem, 100%);
      --project-photo-gap: clamp(
        calc(var(--spacing) * 16 * var(--project-photo-scale)),
        calc(10vw * var(--project-photo-scale)),
        calc(var(--spacing) * 28 * var(--project-photo-scale))
      );
    }

    :global([data-project][data-size="small"]) {
      --project-photo-width: min(25rem, 100%);
      --project-photo-scale: calc(25 / 60);
    }

    :global([data-project][data-size="medium"]) {
      --project-photo-width: min(40rem, 100%);
      --project-photo-scale: calc(40 / 60);
    }

    :global([data-project][data-size="large"]) {
      --project-photo-width: min(60rem, 100%);
      --project-photo-scale: 1;
    }
  }

  [data-project-frame] {
    display: flex;
    flex-direction: column;
    padding-inline: var(--project-pad);
  }

  [data-project-rail] {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 8);
    margin-bottom: calc(var(--spacing) * 10);
  }

  [data-project-rail-top] {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 5);
  }

  [data-project-rail-heading] {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 3);
  }

  [data-project-photos] {
    display: flex;
    flex-direction: column;
    width: var(--project-photo-width);
    max-width: 100%;
    margin-inline: auto;
    gap: var(--project-photo-gap);
    transition:
      width var(--timing-default-half),
      gap var(--timing-default-half);
  }

  @media (min-width: 768px) {
    [data-project-frame] {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
    }

    [data-project-rail] {
      position: fixed;
      top: 0;
      left: var(--project-pad);
      z-index: 1;
      box-sizing: border-box;
      width: var(--project-rail);
      height: 100vh;
      justify-content: space-between;
      gap: 0;
      margin-bottom: 0;
    }

    /* Tablet: fill the frame. Rail overlays; size tokens do not apply. */
    [data-project-photos] {
      width: 100%;
      max-width: 100%;
      margin-inline: auto;
    }
  }

  @media (min-width: 1024px) {
    /* Desktop: size-controlled column, always centered so width
       transitions grow from the middle. Shrink equally on both sides
       so the rail never sits under a photograph. */
    [data-project-photos] {
      --project-photo-used: min(
        var(--project-photo-width),
        calc(100% - 2 * var(--project-left-min))
      );
      width: var(--project-photo-used);
      max-width: 100%;
      margin-inline: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-project-photos] {
      transition: none;
    }
  }
</style>
