---
// About — editorial composition from Figma node 222:23.
// Full-bleed frame (not SectionMain): inset portrait on the right, bio on
// the left, footnote caption tucked beside the photo — not overlaid on it.
//
// Type sizes track the Figma frame (≈13.7 / 10 / 22.5px) rather than the
// fluid body scale so paragraph measure and brand/caption y-positions hold.
import type { ImageMetadata } from "astro";
import Logo from "@components/Logo.astro";
import OptimizedPicture from "@components/OptimizedPicture.astro";
import { isCmsImage, type CmsImage } from "../lib/cms-image";

interface Props {
  paragraphs: string[];
  instagramHref: string;
  instagramHandle: string;
  /** Kept for CMS payloads; the visible signature is <Logo />. */
  brand: string;
  portrait: ImageMetadata | CmsImage;
  portraitAlt?: string;
  caption: string;
  class?: string;
}

const {
  paragraphs,
  instagramHref,
  instagramHandle,
  portrait,
  portraitAlt,
  caption,
  class: className,
} = Astro.props;

const [intro, ...rest] = paragraphs;
const introParts = (intro ?? "").split("{handle}");
const captionParts = caption.split("{handle}");
const cms = isCmsImage(portrait);
const resolvedAlt =
  portraitAlt ?? (cms ? portrait.alt : "Portrait");

const linkClass =
  "underline decoration-from-font underline-offset-4 transition-colors duration-default-quarter hover:text-fg-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus";
---

<section
  id="about"
  class:list={["relative min-h-dvh overflow-hidden bg-panel text-fg", className]}
  aria-labelledby="about-heading"
>
  {
    /*
    Desktop: portrait is capped at the Figma 634×852 and at 85vh so it
    keeps clear viewport gutters — it no longer stretches to fill the
    viewport. Right-aligned, vertically centered. Caption hangs off the
    photo's bottom-left. Bio / back-home stay in the left column.
  */
  }
  <div class="relative flex min-h-dvh flex-col lg:block">
    {/* Bio + brand */}
    <div
      class="relative z-10 px-9 pt-16 sm:px-12 md:pt-20 lg:absolute lg:inset-y-0 lg:left-0 lg:w-[53%] lg:px-0 lg:pt-[4.5rem] lg:pl-9"
    >
      <div class="max-w-[22.6rem] md:my-12 lg:ml-20 md:mt-20">
        <div
          class="space-y-[1em] text-[0.858rem] lowercase leading-[normal] text-fg"
        >
          <h1 id="about-heading" class="sr-only">About aroundtheisla</h1>
          <p>
            {introParts[0]}<a
              href={instagramHref}
              target="_blank"
              rel="noopener noreferrer"
              class={linkClass}>{instagramHandle}</a
            >{introParts[1]}
          </p>
          {rest.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <p class="mt-10 text-fg" aria-hidden="true">
          <Logo class="h-4 w-auto" decorative />
        </p>
      </div>
    </div>

    {
      /* Portrait — in-flow on small screens; capped and centered on desktop */
    }
    <div
      class="about-portrait order-2 mx-6 mt-10 sm:mx-9 lg:order-none lg:mx-0 lg:mt-0"
    >
      <figure class="relative aspect-[634/852] overflow-hidden lg:w-full">
        <OptimizedPicture
          src={cms ? portrait.src : portrait}
          alt={resolvedAlt}
          width={portrait.width}
          height={portrait.height}
          class="absolute inset-0 h-full w-full object-cover object-[center_18%]"
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 1024px) min(635px, 42vw), 100vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>

      {/* Footnote caption — secondary type beside the photo, not overlaid */}
      <p
        class="relative z-10 mt-4 max-w-[9.5rem] text-[0.625rem] lowercase leading-[normal] text-secondary lg:absolute lg:right-full lg:bottom-0 lg:mt-0 lg:mr-4 lg:w-[9.5rem]"
      >
        {captionParts[0]}<a
          href={instagramHref}
          target="_blank"
          rel="noopener noreferrer"
          class={linkClass}>{instagramHandle}</a
        >{captionParts[1]}
      </p>
    </div>

    {/* Back home — page foot on mobile; bottom-left on desktop */}
    <p
      class="relative z-10 order-3 mx-6 mt-8 mb-10 sm:mx-9 lg:absolute lg:bottom-8 lg:left-9 lg:order-none lg:mx-0 lg:mt-0 lg:mb-0"
    >
      <a
        href="/"
        class="inline-flex min-h-11 items-center text-[1.19rem] lowercase leading-none text-fg transition-colors duration-default-quarter hover:text-fg-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
      >
        ← back home
      </a>
    </p>
  </div>
</section>

<style>
  /* Desktop portrait: Figma 634×852 cap, never taller than 85vh,
     right-aligned and vertically centered. Width follows 634/852 so the
     photo stays a contained portrait instead of a full-bleed column. */
  @media (width >= 64rem) {
    .about-portrait {
      position: absolute;
      top: 50%;
      right: calc(var(--spacing) * 10);
      width: min(
        39.7rem,
        calc(46.8% - var(--spacing) * 10),
        calc(85vh * 634 / 852)
      );
      translate: 0 -50%;
    }
  }
</style>
