---
// About — editorial composition from Figma node 222:23.
// Full-bleed frame (not SectionMain): inset portrait on the right, bio on
// the left, footnote caption tucked beside the photo — not overlaid on it.
//
// Type sizes track the Figma frame (≈13.7 / 10 / 22.5px) rather than the
// fluid body scale so paragraph measure and brand/caption y-positions hold.
import { Image } from "astro:assets";
import portrait from "../images/about-portrait.png";
import { about } from "../data/about";

const [intro, ...rest] = about.paragraphs;
const introParts = intro.split("{handle}");
const captionParts = about.caption.split("{handle}");

const linkClass =
  "underline decoration-from-font underline-offset-2 transition-colors duration-default-quarter hover:text-fg-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus";
---

<section
  id="about"
  class="relative min-h-dvh overflow-hidden bg-panel text-fg"
  aria-labelledby="about-heading"
>
  {
    /*
    Desktop proportions from the 1410×886 Figma frame:
    - Portrait: left 53.2%, top 12px, right 25px, bottom 22px
    - Bio: left 50px, top 71px, width 361px
    - Brand: same left, directly under bio
    - Caption: left 41.6%, bottom band, dark type beside the photo
    - Back home: left 37px, bottom band
  */
  }
  <div class="relative flex min-h-dvh flex-col lg:block">
    {/* Bio + brand */}
    <div
      class="relative z-10 px-9 pt-10 sm:px-12 sm:pt-12 lg:absolute lg:inset-y-0 lg:left-0 lg:w-[53%] lg:px-0 lg:pt-[4.5rem] lg:pl-9"
    >
      <div class="max-w-[22.6rem] md:my-12 lg:ml-20 md:mt-20">
        <div
          class="space-y-[1em] text-[0.858rem] lowercase leading-[normal] text-fg"
        >
          <h1 id="about-heading" class="sr-only">About aroundtheisla</h1>
          <p>
            {introParts[0]}<a
              href={about.instagramHref}
              target="_blank"
              rel="noopener noreferrer"
              class={linkClass}>{about.instagramHandle}</a
            >{introParts[1]}
          </p>
          {rest.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <p
          class="mt-10 font-heading text-[1.4rem] font-medium leading-none tracking-[-0.11em] text-fg"
          aria-hidden="true"
        >
          {about.brand}
        </p>
      </div>
    </div>

    {
      /* Portrait — inset on desktop; between bio and caption on small screens */
    }
    <figure
      class="relative order-2 mx-6 mt-10 aspect-[634/852] overflow-hidden sm:mx-9 lg:absolute lg:top-3 lg:right-[1.5625rem] lg:bottom-[1.375rem] lg:left-[53.2%] lg:order-none lg:mx-0 lg:mt-0 lg:aspect-auto"
    >
      <Image
        src={portrait}
        alt={about.portraitAlt}
        class="absolute inset-0 h-full w-full object-cover object-[center_18%]"
        widths={[640, 960, 1280, 1600]}
        sizes="(min-width: 1024px) 45vw, 100vw"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </figure>

    {/* Footnote caption — dark type beside the photo, not overlaid */}
    <p
      class="relative z-10 order-3 mx-6 mt-4 max-w-[9.5rem] text-[0.625rem] lowercase leading-[normal] text-fg sm:mx-9 lg:absolute lg:bottom-[17px] lg:left-[41.6%] lg:order-none lg:mx-0 lg:mt-0 lg:w-[9.5rem]"
    >
      {captionParts[0]}<a
        href={about.instagramHref}
        target="_blank"
        rel="noopener noreferrer"
        class={linkClass}>{about.instagramHandle}</a
      >{captionParts[1]}
    </p>

    {/* Back home — page foot on mobile; bottom-left on desktop */}
    <p
      class="relative z-10 order-4 mx-6 mt-8 mb-10 sm:mx-9 lg:absolute lg:bottom-8 lg:left-9 lg:order-none lg:mx-0 lg:mt-0 lg:mb-0"
    >
      <a
        href="/"
        class="inline-flex min-h-11 items-center text-[1.19rem] lowercase leading-none text-fg transition-colors duration-default-quarter hover:text-fg-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
      >
        ← back home
      </a>
    </p>
  </div>
</section>
