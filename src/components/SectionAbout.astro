---
// About — editorial composition from Figma node 222:23.
// Full-bleed frame (not SectionMain): inset portrait on the right, bio on
// the left, footnote caption tucked beside the photo — not overlaid on it.
//
// Type sizes track the Figma frame (≈13.7 / 10 / 22.5px) rather than the
// fluid body scale so paragraph measure and brand/caption y-positions hold.
import type { ImageMetadata } from "astro";
import Logo from "@components/Logo.astro";
import OptimizedPicture from "@components/OptimizedPicture.astro";
import ReturnLink from "@components/ReturnLink.astro";
import { isCmsImage, type CmsImage } from "../lib/cms-image";

interface Props {
  paragraphs: string[];
  instagramHref: string;
  instagramHandle: string;
  email?: string;
  phone?: string;
  /** Kept for CMS payloads; the visible signature is <Logo />. */
  brand: string;
  portrait: ImageMetadata | CmsImage;
  portraitAlt?: string;
  caption: string;
  class?: string;
}

const {
  paragraphs,
  instagramHref,
  instagramHandle,
  email,
  phone,
  portrait,
  portraitAlt,
  caption,
  class: className,
} = Astro.props;

const [intro, ...rest] = paragraphs;
const introText = intro ?? "";
const introHasHandle = introText.includes("{handle}");
const introParts = introText.split("{handle}");
const captionHasHandle = caption.includes("{handle}");
const captionParts = caption.split("{handle}");
const captionHasContent = caption.length > 0;
const cms = isCmsImage(portrait);
const resolvedAlt =
  portraitAlt ?? (cms ? portrait.alt : "Portrait");

const linkClass =
  "underline decoration-from-font underline-offset-4 transition-colors duration-default-quarter hover:text-fg-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus";

const handleLabel = instagramHandle.startsWith("@")
  ? instagramHandle
  : `@${instagramHandle}`;
const phoneHref = phone ? `tel:${phone.replace(/[^\d+]/g, "")}` : undefined;
---

<section
  id="about"
  class:list={["relative min-h-dvh overflow-hidden bg-panel text-fg", className]}
  aria-labelledby="about-heading"
>
  {
    /*
    Desktop: portrait scales with the viewport, capped at 50rem and
    96vh. Right-aligned, vertically centered. Caption hangs off the
    photo's bottom-left. Bio / back-home stay in the left column.
  */
  }
  <div class="relative flex min-h-dvh flex-col lg:block">
    {/* Bio + brand */}
    <div
      class="relative z-10 px-9 pt-16 sm:px-12 md:pt-20 lg:absolute lg:inset-y-0 lg:left-0 lg:w-[53%] lg:px-0 lg:pt-[4.5rem] lg:pl-9"
    >
      <div class="max-w-[22.6rem] md:my-12 lg:ml-20 md:mt-20">
        <div
          class="space-y-[1em] text-[0.858rem] lowercase leading-[normal] text-fg"
        >
          <h1 id="about-heading" class="sr-only">About aroundtheisla</h1>
          <p>
            {
              introHasHandle ? (
                <>
                  {introParts[0]}
                  <a
                    href={instagramHref}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={linkClass}
                  >
                    {instagramHandle}
                  </a>
                  {introParts[1]}
                </>
              ) : (
                introText
              )
            }
          </p>
          {rest.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <div class="mt-10">
          <p class="text-fg" aria-hidden="true">
            <Logo class="h-4 w-auto" decorative />
          </p>
          <address
            class="mt-4 not-italic text-[0.858rem] leading-[normal] text-fg"
            aria-label="Contact"
          >
            {
              email && (
                <p>
                  <a href={`mailto:${email}`} class={linkClass}>
                    E {email}
                  </a>
                </p>
              )
            }
            <p>
              <a
                href={instagramHref}
                target="_blank"
                rel="noopener noreferrer"
                class={linkClass}
              >
                IG {handleLabel}
              </a>
            </p>
            {
              phone && phoneHref && (
                <p>
                  <a href={phoneHref} class={linkClass}>
                    P {phone}
                  </a>
                </p>
              )
            }
          </address>
        </div>
      </div>
    </div>

    {
      /* Portrait — in-flow on small screens; capped and centered on desktop */
    }
    <div
      class="about-portrait order-2 mx-6 mt-10 sm:mx-9 lg:order-none lg:mx-0 lg:mt-0"
    >
      <figure class="relative aspect-[634/852] overflow-hidden lg:w-full">
        <OptimizedPicture
          src={cms ? portrait.src : portrait}
          alt={resolvedAlt}
          width={portrait.width}
          height={portrait.height}
          class="absolute inset-0 h-full w-full object-cover object-[center_18%]"
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 1024px) min(50rem, 48vw, 72vh), 100vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>

      {
        captionHasContent && (
          <p class="relative z-10 mt-4 max-w-[9.5rem] text-[0.625rem] lowercase leading-[normal] text-secondary lg:absolute lg:right-full lg:bottom-0 lg:mt-0 lg:mr-4 lg:w-[9.5rem]">
            {captionHasHandle ? (
              <>
                {captionParts[0]}
                <a
                  href={instagramHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={linkClass}
                >
                  {instagramHandle}
                </a>
                {captionParts[1]}
              </>
            ) : (
              caption
            )}
          </p>
        )
      }
    </div>

    {/* Return — page foot on mobile; bottom-left on desktop */}
    <p
      class="relative z-10 order-3 mx-6 mt-8 mb-10 sm:mx-9 lg:absolute lg:bottom-8 lg:left-9 lg:order-none lg:mx-0 lg:mt-0 lg:mb-0"
    >
      <ReturnLink href="/" />
    </p>
  </div>
</section>

<style>
  /* Desktop portrait — viewport-scaled, 50rem / 96vh cap, 634/852 ratio. */
  @media (width >= 64rem) {
    .about-portrait {
      position: absolute;
      top: 50%;
      right: calc(var(--spacing) * 6);
      width: min(
        50rem,
        calc(48% - var(--spacing) * 6),
        calc(96vh * 634 / 852)
      );
      translate: 0 -50%;
    }
  }
</style>
