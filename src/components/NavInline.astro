---
/**
 * NavInline
 * Desktop: wordmark + bold inline links (Figma Home ALT 222:520). No hamburger.
 * Mobile overlay: Figma 333:26 — left-aligned work/about, studio email,
 * palm mark. Dark-theme scrim: a local gradient from canvas → transparent
 * so the transparent bar stays readable over photographs. Not a theme role.
 */
import Logo from "./Logo.astro";
import palmMark from "../images/loader-palm.svg?raw";

type PlainLink = { label: string; href: string };

interface Props {
  /** Accessible name for the home link. The visible mark is <Logo />. */
  brand?: string;
  /** Home / logo href. */
  homeHref?: string;
  /** Primary links — desktop row + mobile drawer. */
  links?: PlainLink[];
  /** Optional leftover CTA; the mobile overlay no longer renders it. */
  cta?: PlainLink;
  /** Studio email in the mobile overlay (Figma 333:26). */
  email?: string;
  class?: string;
}

const {
  brand = "aroundtheisla",
  homeHref = "/",
  links = [
    { label: "work", href: "/work" },
    { label: "about", href: "/about" },
  ],
  email = "didielo@aroundtheisla.com",
  class: className = "",
} = Astro.props;

const drawerLinkClass =
  "h1 font-bold lowercase text-fg outline-none transition hover:text-intent hover:underline underline-offset-4 focus-visible:underline focus-visible:ring-2 focus-visible:ring-focus focus-visible:ring-offset-2 focus-visible:ring-offset-canvas";

const linkClass =
  "font-heading text-lg font-bold tracking-tight text-fg outline-none transition hover:text-intent hover:underline underline-offset-4 focus-visible:underline focus-visible:ring-2 focus-visible:ring-focus focus-visible:ring-offset-2 focus-visible:ring-offset-canvas";
---

{
  /*
  Site nav: wordmark left; on md+ bold inline links on the right (no hamburger).
  Below md, hamburger opens the full-screen overlay.
*/
}
<header
  data-nav-inline
  data-open="false"
  class:list={["fixed inset-x-0 top-0 z-50", className]}
>
  <slot name="announcement" />

  {
    /* Dark-theme only: fades canvas → transparent so light links hold
       contrast over a photograph. Hidden while the overlay is open. */
  }
  <div data-nav-scrim aria-hidden="true"></div>

  <div
    data-nav-bar
    class="container-full relative z-20 flex h-14 items-center justify-between pl-5 pr-4 transition-colors duration-300 md:px-[1.625rem]"
  >
    <a
      href={homeHref}
      aria-label={`${brand} home`}
      class="inline-flex h-14 items-center text-fg outline-none transition hover:text-intent focus-visible:ring-2 focus-visible:ring-focus focus-visible:ring-offset-2 focus-visible:ring-offset-canvas"
    >
      <Logo class="h-5 w-auto shrink-0" decorative />
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
      {
        links.map((link) => (
          <a href={link.href} class={linkClass}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <button
      type="button"
      data-nav-toggle
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="nav-inline-panel"
      class="grid h-9 w-9 place-items-center text-fg transition hover:text-intent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus focus-visible:ring-offset-2 focus-visible:ring-offset-canvas md:hidden"
    >
      {
        /* Two-line mark from the Figma header — not a three-line lucide menu. */
      }
      <svg class="h-4 w-4" viewBox="0 0 18 12" fill="none" aria-hidden="true">
        <path
          data-nav-icon-open
          d="M0 1.5h18M0 10.5h18"
          stroke="currentColor"
          stroke-width="1.9"
          stroke-linecap="square"></path>
        <path
          data-nav-icon-close
          class="hidden"
          d="M1 1l16 10M17 1L1 11"
          stroke="currentColor"
          stroke-width="1.9"
          stroke-linecap="square"></path>
      </svg>
    </button>
  </div>

  <div
    id="nav-inline-panel"
    data-nav-panel
    data-theme="dark"
    role="dialog"
    aria-modal="true"
    aria-label="Primary"
    inert
  >
    <nav
      data-nav-links
      class="flex flex-col items-start gap-6 text-left"
      aria-label="Primary"
    >
      {
        links.map((link) => (
          <a href={link.href} class={drawerLinkClass}>
            {link.label}
          </a>
        ))
      }
    </nav>
    {
      email && (
        <div data-nav-meta>
          <a
            href={`mailto:${email}`}
            class="text-body-md lowercase text-fg outline-none transition hover:text-intent hover:underline underline-offset-4 focus-visible:underline focus-visible:ring-2 focus-visible:ring-focus focus-visible:ring-offset-2 focus-visible:ring-offset-canvas"
          >
            {email}
          </a>
          <div
            data-nav-palm
            class="text-fg"
            aria-hidden="true"
            set:html={palmMark}
          />
        </div>
      )
    }
  </div>
</header>

<style>
  /* Open-state ancestors use :global so Astro's scope hash doesn't attach to
     the JS-toggled [data-open] attribute (see components.styling). */

  /* Readable band behind the transparent bar in dark theme only. */
  [data-nav-scrim] {
    display: none;
    position: absolute;
    inset-inline: 0;
    top: 0;
    z-index: 10;
    height: 8rem;
    pointer-events: none;
    background-image: linear-gradient(
      to bottom,
      color-mix(in oklab, var(--color-canvas) 72%, transparent),
      transparent
    );
  }

  :global([data-theme="dark"]) [data-nav-scrim] {
    display: block;
  }

  :global([data-nav-inline][data-open="true"]) [data-nav-scrim] {
    display: none;
  }

  /* Frosted fill is mobile-only. Tablet+ (md) stays transparent over the page. */
  @media (max-width: 47.999rem) {
    [data-nav-bar].is-scrolled {
      background-color: color-mix(in oklab, var(--color-canvas) 92%, transparent);
      backdrop-filter: blur(8px);
    }
  }

  /* When the overlay is open the bar sits on black — keep it transparent so
     the panel shows through (bar flips to dark tokens via JS). */
  :global([data-nav-inline][data-open="true"]) [data-nav-bar] {
    background-color: transparent;
    backdrop-filter: none;
  }

  [data-nav-panel] {
    position: fixed;
    inset: 0;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: space-between;
    /* Top pad clears the fixed bar so links share the wordmark's left edge. */
    padding-top: calc(var(--spacing) * 22);
    padding-bottom: calc(var(--spacing) * 10);
    padding-inline: calc(var(--spacing) * 5);
    background-color: var(--color-canvas);
    color: var(--color-fg);
    /* Reveal downward from the top edge into the full viewport. */
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    pointer-events: none;
    transition:
      clip-path var(--timing-default),
      visibility 0s linear var(--duration-default);
  }

  :global([data-nav-inline][data-open="true"]) [data-nav-panel] {
    clip-path: inset(0 0 0 0);
    visibility: visible;
    pointer-events: auto;
    transition:
      clip-path var(--timing-default),
      visibility 0s linear 0s;
  }

  /* Links and footer ease in from above as the panel opens. */
  [data-nav-links],
  [data-nav-meta] {
    opacity: 0;
    transform: translateY(-1.5rem);
    transition:
      opacity var(--timing-default-half),
      transform var(--timing-default);
  }

  :global([data-nav-inline][data-open="true"]) [data-nav-links],
  :global([data-nav-inline][data-open="true"]) [data-nav-meta] {
    opacity: 1;
    transform: translateY(0);
    transition-delay: var(--duration-default-quarter);
  }

  [data-nav-meta] {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: calc(var(--spacing) * 6);
  }

  [data-nav-palm] :global(svg) {
    display: block;
    height: 3.5rem;
    width: auto;
  }

  :global(html.nav-inline-open) {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-nav-bar],
    [data-nav-panel],
    [data-nav-links],
    [data-nav-meta] {
      transition: none !important;
    }

    [data-nav-panel] {
      clip-path: inset(0 0 0 0);
      opacity: 0;
      transition:
        opacity var(--timing-default-quarter),
        visibility 0s linear var(--duration-default-quarter) !important;
    }

    :global([data-nav-inline][data-open="true"]) [data-nav-panel] {
      opacity: 1;
      transition:
        opacity var(--timing-default-quarter),
        visibility 0s linear 0s !important;
    }

    [data-nav-links],
    [data-nav-meta] {
      transform: none;
    }
  }
</style>

<script>
  const initialized = new WeakSet<HTMLElement>();

  const init = (root: HTMLElement) => {
    if (initialized.has(root)) return;
    initialized.add(root);

    const navBar = root.querySelector<HTMLElement>("[data-nav-bar]");
    const toggle = root.querySelector<HTMLButtonElement>("[data-nav-toggle]");
    const panel = root.querySelector<HTMLElement>("[data-nav-panel]");
    const links = root.querySelector<HTMLElement>("[data-nav-links]");
    const iconOpen = root.querySelector<SVGElement>("[data-nav-icon-open]");
    const iconClose = root.querySelector<SVGElement>("[data-nav-icon-close]");
    if (!toggle || !panel || !links) return;

    let isScrolled = false;
    const updateScroll = () => {
      if (!navBar || root.dataset.open === "true") return;
      const scrolled = window.scrollY > 12;
      if (scrolled === isScrolled) return;
      isScrolled = scrolled;
      navBar.classList.toggle("is-scrolled", scrolled);
    };
    updateScroll();
    window.addEventListener("scroll", updateScroll, { passive: true });

    const mqDesktop = window.matchMedia("(min-width: 768px)");
    const closeIfDesktop = () => {
      if (mqDesktop.matches && root.dataset.open === "true") {
        setOpen(false);
      }
    };
    mqDesktop.addEventListener("change", closeIfDesktop);

    const trapItems = () =>
      [
        toggle,
        ...Array.from(
          panel.querySelectorAll<HTMLElement>(
            'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
          ),
        ),
      ].filter((el) => !el.hasAttribute("disabled"));

    const setOpen = (open: boolean) => {
      root.dataset.open = open ? "true" : "false";
      iconOpen?.classList.toggle("hidden", open);
      iconClose?.classList.toggle("hidden", !open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      document.documentElement.classList.toggle("nav-inline-open", open);

      if (open) {
        navBar?.setAttribute("data-theme", "dark");
        navBar?.classList.remove("is-scrolled");
        panel.removeAttribute("inert");
        requestAnimationFrame(() => {
          links.querySelector<HTMLElement>("a[href], button")?.focus();
        });
      } else {
        navBar?.removeAttribute("data-theme");
        panel.setAttribute("inert", "");
        updateScroll();
        // Toggle is md:hidden on desktop — don't park focus on a display:none control.
        if (!mqDesktop.matches) toggle.focus();
      }
    };

    toggle.addEventListener("click", () => {
      setOpen(root.dataset.open !== "true");
    });

    panel.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    root.addEventListener("keydown", (e) => {
      if (root.dataset.open !== "true") return;

      if (e.key === "Escape") {
        e.preventDefault();
        setOpen(false);
        return;
      }

      if (e.key !== "Tab") return;
      const items = trapItems();
      if (items.length === 0) return;
      const first = items[0]!;
      const last = items[items.length - 1]!;
      const active = document.activeElement as HTMLElement | null;

      if (e.shiftKey && active === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      }
    });
  };

  document.querySelectorAll<HTMLElement>("[data-nav-inline]").forEach(init);
</script>
