---
// Site footer — right-aligned copyright. Layouts include this unless
// `hideFooter` is set on the page.
// `{current_year}` in the copy is replaced with the visitor's year in JS;
// the build year is rendered as a no-JS fallback.
import { site } from "../data/site";

interface Props {
  copyright?: string;
  class?: string;
}

const YEAR_TOKEN = "{current_year}";
const { copyright = site.copyright, class: className } = Astro.props;
const year = String(new Date().getFullYear());
const copyrightParts = copyright.split(YEAR_TOKEN);
---

<footer id="site-footer" class:list={["px-site-margin py-6", className]}>
  <p class="text-right text-body-sm text-fg-muted" data-footer-copyright>{
    copyrightParts.map((part, index) => (
      <>{part}{index < copyrightParts.length - 1 && <span data-current-year>{year}</span>}</>
    ))
  }</p>
</footer>

<script>
  const initialized = new WeakSet<HTMLElement>();

  function initFooterYear() {
    const year = String(new Date().getFullYear());
    document.querySelectorAll<HTMLElement>("[data-current-year]").forEach((el) => {
      if (initialized.has(el)) return;
      initialized.add(el);
      el.textContent = year;
    });
  }

  initFooterYear();
</script>
