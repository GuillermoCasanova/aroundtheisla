---
/**
 * SectionWork
 * Work index — Figma Projects Grid (268:92) and List (268:235).
 * Two tabpanels: a vertically scrolling 2-column grid (including
 * mobile), and a numbered name list. Desktop (lg+) uses h2-size
 * titles and a large sticky cover that swaps on hover/focus.
 * Tablet and mobile stay names-only.
 * Full-bleed by design (no SectionMain).
 */
import type { ImageMetadata } from "astro";
import OptimizedPicture from "@components/OptimizedPicture.astro";
import { isCmsImage, type CmsImage } from "../lib/cms-image";

type Cover = ImageMetadata | CmsImage;

export type WorkItem = {
  slug: string;
  title: string;
  year: number;
  cover: Cover;
  href: string;
};

interface Props {
  projects: WorkItem[];
  class?: string;
}

const { projects: items, class: className } = Astro.props;

const tabClass =
  "cursor-pointer text-body-md text-fg outline-none hover:underline underline-offset-2 focus-visible:ring-2 focus-visible:ring-focus focus-visible:ring-offset-2 focus-visible:ring-offset-canvas";

function padIndex(index: number) {
  return String(index + 1).padStart(2, "0");
}

function coverAlt(item: WorkItem) {
  return isCmsImage(item.cover) ? item.cover.alt || item.title : item.title;
}
---

<section
  id="work-gallery"
  data-work-gallery
  data-view="grid"
  aria-label="Work projects"
  class:list={["relative bg-canvas text-fg section-pt-sm", className]}
>
  <header data-work-chrome>
    <h1 data-work-title class="h1 font-bold lowercase text-fg">work</h1>
    <div
      class="flex items-center gap-4 md:flex-col md:items-start md:gap-2"
      role="tablist"
      aria-label="Gallery view"
    >
      <button
        type="button"
        role="tab"
        id="work-view-grid"
        data-work-view="grid"
        aria-controls="work-panel-grid"
        aria-selected="true"
        tabindex="0"
        class:list={[tabClass, "font-bold"]}
      >
        Grid
      </button>
      <button
        type="button"
        role="tab"
        id="work-view-list"
        data-work-view="list"
        aria-controls="work-panel-list"
        aria-selected="false"
        tabindex="-1"
        class:list={[tabClass, "font-normal"]}
      >
        List
      </button>
    </div>
  </header>

  <div
    id="work-panel-grid"
    data-work-panel="grid"
    role="tabpanel"
    aria-labelledby="work-view-grid"
  >
    <ul data-work-grid>
      {
        items.map((item, i) => (
          <li class="min-w-0">
            <a
              href={item.href}
              class="flex h-full flex-col gap-3 outline-none focus-visible:ring-2 focus-visible:ring-focus focus-visible:ring-offset-2 focus-visible:ring-offset-canvas"
              aria-label={`${item.title}, ${item.year}`}
            >
              <div class="relative aspect-[4/5] w-full overflow-hidden">
                <OptimizedPicture
                  src={isCmsImage(item.cover) ? item.cover.src : item.cover}
                  alt={
                    isCmsImage(item.cover)
                      ? item.cover.alt || item.title
                      : item.title
                  }
                  width={item.cover.width}
                  height={item.cover.height}
                  class="absolute inset-0 size-full object-cover"
                  widths={[360, 540, 720, 960, 1280]}
                  sizes="(max-width: 767px) 46vw, min(48rem, 44vw)"
                  loading={i < 4 ? "eager" : "lazy"}
                  fetchpriority={i === 0 ? "high" : undefined}
                  decoding={i === 0 ? "sync" : "async"}
                />
              </div>
              <div class="flex items-baseline justify-between gap-3">
                <span class="min-w-0 truncate text-body-md font-bold text-fg">
                  {item.title}
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div
    id="work-panel-list"
    data-work-panel="list"
    role="tabpanel"
    aria-labelledby="work-view-list"
    hidden
  >
    <ol data-work-names>
      {
        items.map((item, i) => (
          <li class="mb-2 last:mb-0 lg:mb-4">
            <a
              href={item.href}
              data-work-name
              data-work-index={i}
              data-active="false"
              aria-label={item.title}
              class="inline-flex min-h-11 min-w-0 items-baseline gap-2 text-body-md font-normal text-fg outline-none focus-visible:ring-2 focus-visible:ring-focus focus-visible:ring-offset-2 focus-visible:ring-offset-canvas lg:flex lg:min-h-0 lg:h2 lg:font-normal"
            >
              <span aria-hidden="true" class="lg:hidden">
                {padIndex(i)}.
              </span>
              <span aria-hidden="true">{item.title}</span>
            </a>
          </li>
        ))
      }
    </ol>
    <div data-work-preview>
      {
        items.map((item) => (
          <div
            data-work-preview-item
            data-alt={coverAlt(item)}
            data-active="false"
            aria-hidden="true"
          >
            <OptimizedPicture
              src={isCmsImage(item.cover) ? item.cover.src : item.cover}
              alt=""
              width={item.cover.width}
              height={item.cover.height}
              class="size-full object-cover"
              widths={[540, 720, 960, 1280]}
              sizes="(min-width: 1024px) min(48rem, 42vw), 100vw"
              loading="lazy"
              decoding="async"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /*
   * Grid and list stay viewport-centered; width shrinks so both
   * side margins are at least the rail reserve.
   */
  [data-work-gallery] {
    --work-pad: calc(var(--spacing) * 6.5);
    --work-rail: 6rem;
    --work-rail-gap: calc(var(--spacing) * 16);
    --work-left-min: calc(var(--work-rail) + var(--work-rail-gap));
    --work-gallery-inset: 20.1875rem;
    --work-thumb: min(48rem, 42vw, calc((100svh - 7rem) * 4 / 5));
    /* Match SectionProject rail (`md:section-pt-xs` = 4rem). */
    --work-chrome-pt: calc(var(--spacing) * 16);
    --work-grid-thumb: 48rem;
    --work-thumb-gap: calc(var(--spacing) * 14);
    --project-grid-max-width: 78rem;
    --work-content-width: min(
      calc(var(--work-grid-thumb) * 2 + var(--work-thumb-gap)),
      var(--project-grid-max-width)
    );

    min-height: 100svh;
    padding-inline: clamp(
      calc(var(--spacing) * 5),
      2.5vw,
      calc(var(--spacing) * 6.2)
    );
    padding-bottom: clamp(
      calc(var(--spacing) * 8),
      6vh,
      calc(var(--spacing) * 18)
    );
  }

  [data-work-chrome] {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: calc(var(--spacing) * 4);
    min-height: 2.75rem;
    margin-bottom: calc(var(--spacing) * 8);
  }

  /*
   * Display type carries extra leading and font-metric space above the
   * cap height. Trim the line box so "work" sits on the same edge as
   * the first project thumbnail.
   */
  [data-work-title] {
    line-height: 1;
    text-box: trim-both cap alphabetic;
  }

  [data-work-grid] {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: calc(var(--spacing) * 3);
    row-gap: calc(var(--spacing) * 5);
  }

  [data-work-names] {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  /* `lg:h2` supplies size; keep names regular against that utility's 600. */
  [data-work-name] {
    font-weight: 400;
  }

  [data-work-name]:hover span,
  [data-work-name]:focus-visible span,
  [data-work-name][data-active="true"] span {
    text-decoration-line: underline;
    text-underline-offset: 0.18em;
  }

  [data-work-preview] {
    display: none;
  }

  [data-work-panel][hidden] {
    display: none;
  }

  @media (min-width: 768px) {
    [data-work-gallery] {
      display: grid;
      padding-top: 0;
      padding-inline: var(--work-pad);
      grid-template-columns: var(--work-rail) minmax(0, 1fr);
      column-gap: clamp(
        var(--work-rail-gap),
        12.55vw,
        calc(var(--work-gallery-inset) - var(--work-pad) - var(--work-rail))
      );
      align-items: start;
    }

    [data-work-chrome] {
      position: fixed;
      top: 0;
      left: var(--work-pad);
      z-index: 1;
      box-sizing: border-box;
      width: var(--work-rail);
      height: 100vh;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      gap: calc(var(--spacing) * 7);
      margin-bottom: 0;
      padding-top: var(--work-chrome-pt);
      padding-bottom: calc(var(--spacing) * 8);
    }

    [data-work-panel] {
      grid-column: 1 / -1;
      grid-row: 1;
      min-width: 0;
    }

    [data-work-panel="grid"] {
      padding-top: var(--work-chrome-pt);
    }

    [data-work-grid],
    [data-work-panel="list"]:not([hidden]) {
      --work-content-used: min(
        var(--work-content-width),
        calc(100% - 2 * var(--work-left-min))
      );
      width: var(--work-content-used);
      max-width: 100%;
      margin-inline: auto;
    }

    [data-work-grid] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(calc(var(--spacing) * 8), 4vw, var(--work-thumb-gap));
      row-gap: calc(var(--spacing) * 10);
      justify-content: center;
    }

    [data-work-panel="list"]:not([hidden]) {
      padding-top: var(--work-chrome-pt);
    }
  }

  @media (min-width: 1024px) {
    [data-work-panel="list"]:not([hidden]) {
      display: grid;
      grid-template-columns: minmax(12rem, 1fr) var(--work-thumb);
      gap: clamp(calc(var(--spacing) * 8), 5vw, var(--work-thumb-gap));
      align-items: start;
      min-height: calc(100svh - 8rem);
    }

    [data-work-preview] {
      display: block;
      position: sticky;
      top: var(--work-chrome-pt);
      z-index: 0;
      width: var(--work-thumb);
      max-width: 100%;
      height: auto;
      aspect-ratio: 4 / 5;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    [data-work-preview][data-visible="true"] {
      opacity: 1;
      visibility: visible;
    }

    [data-work-preview-item] {
      position: absolute;
      inset: 0;
      overflow: hidden;
      opacity: 0;
      pointer-events: none;
    }

    [data-work-preview-item][data-active="true"] {
      opacity: 1;
    }

  }
</style>

<script>
  type ViewMode = "grid" | "list";

  const STORAGE_KEY = "work-view";
  const initialized = new WeakSet<HTMLElement>();
  const controllers = new WeakMap<HTMLElement, AbortController>();

  function parseView(value: string | null | undefined): ViewMode | null {
    if (value === "grid" || value === "list") return value;
    return null;
  }

  function readInitialView(): ViewMode {
    const params = new URLSearchParams(window.location.search);
    const fromQuery = parseView(params.get("view"));
    if (fromQuery) return fromQuery;
    try {
      const fromStorage = parseView(sessionStorage.getItem(STORAGE_KEY));
      if (fromStorage) return fromStorage;
    } catch {
      /* private mode */
    }
    return "grid";
  }

  function persistView(view: ViewMode) {
    try {
      sessionStorage.setItem(STORAGE_KEY, view);
    } catch {
      /* private mode */
    }
    const url = new URL(window.location.href);
    if (view === "grid") url.searchParams.delete("view");
    else url.searchParams.set("view", view);
    window.history.replaceState({}, "", url);
  }

  function syncTabs(root: HTMLElement, view: ViewMode) {
    const tabs = root.querySelectorAll<HTMLButtonElement>("[data-work-view]");
    tabs.forEach((tab) => {
      const active = tab.dataset.workView === view;
      tab.setAttribute("aria-selected", String(active));
      tab.tabIndex = active ? 0 : -1;
      tab.classList.toggle("font-bold", active);
      tab.classList.toggle("font-normal", !active);
    });
  }

  function setActivePreview(root: HTMLElement, index: number | null) {
    const preview = root.querySelector<HTMLElement>("[data-work-preview]");
    const names = root.querySelectorAll<HTMLElement>("[data-work-name]");
    const shots = root.querySelectorAll<HTMLElement>(
      "[data-work-preview-item]",
    );
    const on = index !== null && Number.isFinite(index);

    if (preview) preview.dataset.visible = String(on);

    names.forEach((el, i) => {
      el.dataset.active = String(on && i === index);
    });

    shots.forEach((el, i) => {
      const isOn = on && i === index;
      el.dataset.active = String(isOn);
      el.setAttribute("aria-hidden", String(!isOn));
      const img = el.querySelector("img");
      if (!img) return;
      img.alt = isOn ? el.dataset.alt || "" : "";
    });
  }

  function setView(root: HTMLElement, view: ViewMode, instant = false) {
    if (!instant && root.dataset.view === view) return;

    root.dataset.view = view;
    syncTabs(root, view);
    persistView(view);

    root.querySelectorAll<HTMLElement>("[data-work-panel]").forEach((panel) => {
      panel.hidden = panel.dataset.workPanel !== view;
    });

    if (view !== "list") setActivePreview(root, null);

    if (!instant) window.scrollTo(0, 0);
  }

  function bindRoot(root: HTMLElement) {
    if (initialized.has(root)) return;
    initialized.add(root);

    controllers.get(root)?.abort();
    const controller = new AbortController();
    controllers.set(root, controller);
    const { signal } = controller;

    const tabs = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-work-view]"),
    );

    tabs.forEach((tab) => {
      tab.addEventListener(
        "click",
        () => {
          const view = parseView(tab.dataset.workView);
          if (view) setView(root, view);
        },
        { signal },
      );

      tab.addEventListener(
        "keydown",
        (e: KeyboardEvent) => {
          const current = tabs.indexOf(tab);
          let next = -1;
          if (e.key === "ArrowRight" || e.key === "ArrowDown") {
            next = (current + 1) % tabs.length;
          } else if (e.key === "ArrowLeft" || e.key === "ArrowUp") {
            next = (current - 1 + tabs.length) % tabs.length;
          } else if (e.key === "Home") {
            next = 0;
          } else if (e.key === "End") {
            next = tabs.length - 1;
          }
          if (next < 0) return;
          e.preventDefault();
          const nextTab = tabs[next];
          if (!nextTab) return;
          nextTab.focus();
          const view = parseView(nextTab.dataset.workView);
          if (view) setView(root, view);
        },
        { signal },
      );
    });

    const namesList = root.querySelector<HTMLElement>("[data-work-names]");
    namesList?.addEventListener(
      "mouseleave",
      () => setActivePreview(root, null),
      { signal },
    );
    namesList?.addEventListener(
      "focusout",
      (e: FocusEvent) => {
        const next = e.relatedTarget;
        if (next instanceof Node && namesList.contains(next)) return;
        setActivePreview(root, null);
      },
      { signal },
    );

    root.querySelectorAll<HTMLElement>("[data-work-name]").forEach((el) => {
      const index = Number(el.dataset.workIndex);
      if (!Number.isFinite(index)) return;
      el.addEventListener("mouseenter", () => setActivePreview(root, index), {
        signal,
      });
      el.addEventListener("focusin", () => setActivePreview(root, index), {
        signal,
      });
    });

    setView(root, readInitialView(), true);
  }

  function initAll() {
    document
      .querySelectorAll<HTMLElement>("[data-work-gallery]")
      .forEach((root) => bindRoot(root));
  }

  initAll();
</script>
