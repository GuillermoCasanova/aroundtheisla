        fill="currentColor"></path>
      <path
        d="M31.452 74.1312C28.9004 71.862 25.3281 68.5969 21.9342 69.1667C20.5865 69.4441 19.2488 69.4739 17.9209 69.1171C15.84 69.781 14.1058 70.8859 12.3073 72.1196C11.5492 72.6399 11.1578 73.2196 10.6029 73.9182C7.85804 77.3765 4.55826 78.6796 2.92323 81.7663L10.043 79.9281C12.2677 79.3534 14.7896 79.3385 16.9845 79.7349L22.0283 80.6416C23.4503 80.8943 24.7484 81.6573 26.2596 81.5136C29.7872 82.1775 33.196 82.2023 36.699 81.5136C36.8674 81.7019 37.13 81.9992 37.0805 82.1379C37.0161 82.3262 36.5256 82.6978 36.3274 82.7176L29.272 83.2874C26.3091 83.0991 23.6534 82.0784 20.7847 81.6127L15.731 80.7853C11.1231 80.5623 6.78289 81.9595 2.50208 83.3567C1.67961 83.6243 0.911652 83.6193 0 83.4261C0.143684 82.7374 0.312139 81.687 0.678782 81.3204L3.39393 78.6201L7.1 74.9933C9.68631 72.1147 13.7491 69.2459 17.3858 68.0568L18.2033 56.6314L19.6203 46.4249C20.2496 41.9063 22.2909 37.9624 23.8665 33.741L26.8095 25.8384C26.8888 25.6303 27.305 25.2934 27.4932 25.1844C27.6815 25.0754 28.2365 25.4272 28.3851 25.6551C26.9482 28.3306 26.1654 31.3083 25.115 34.177C23.5841 38.3637 21.5427 42.2333 20.9185 46.7024L19.4222 57.4242L18.6889 68.1906L20.7302 68.0667L24.134 67.8586L23.8417 61.482C23.6088 56.4382 23.7773 51.4836 24.4808 46.524L25.5609 38.9335C26.0663 35.3711 27.0275 32.0366 28.7716 28.8756L30.4165 25.8979L30.7881 25.3281C30.902 25.1547 31.7493 25.4519 31.7146 25.665C31.2489 28.3108 28.1027 31.0606 27.1117 37.7345L25.7443 46.96L25.1695 54.1938L25.1497 61.7545L25.4371 68.4334C27.8995 69.7414 30.2183 70.99 32.0763 72.9421C33.2704 74.1956 34.4396 75.2163 35.8715 76.2072C36.6246 76.7274 37.3034 77.4905 37.9128 78.1841L40.6181 81.2609C40.4794 81.5235 39.6767 81.9298 39.3893 81.801C39.102 81.6722 38.6015 81.365 38.3191 81.033L35.4603 77.7035L31.4421 74.1312H31.452Z"
        fill="currentColor"></path>
      <path
        d="M13.279 27.1218C17.6737 23.6634 21.8653 22.9202 27.3551 22.5189C27.6276 22.4991 28.2767 22.9896 28.2172 23.2423C27.8951 24.5949 21.2906 23.1927 15.6622 27.097L10.6927 30.5454C8.93377 31.7692 8.68107 33.9592 7.55637 33.6272C5.8718 33.1268 9.96433 27.7163 11.525 25.6403L13.8289 22.5635C14.8545 21.196 15.9 20.111 17.421 19.3826C20.7753 17.7674 25.1899 18.8327 27.5384 21.528C27.5136 21.7361 27.1123 22.3505 26.8844 22.2761C26.1115 22.0235 23.9562 19.447 20.052 19.9276C18.6647 20.0961 16.8017 20.8542 15.9842 21.964L13.3483 25.5561L11.0048 28.514C12.0254 28.0681 12.5457 27.7015 13.2839 27.1168L13.279 27.1218Z"
        fill="currentColor"></path>
    </svg>
  </div>
</div>

{/* Without JS the stage would cover the image forever — hide it. */}
<noscript>
  <style>
    [data-image-loader-stage] {
      display: none !important;
    }
  </style>
</noscript>

<style>
  .image-loader__stage {
    transition: opacity var(--timing-default-half);
  }

  .image-loader[data-image-loader-state="ready"] .image-loader__stage {
    opacity: 0;
    pointer-events: none;
  }

  .image-loader[data-image-loader-state="done"] .image-loader__stage {
    display: none;
  }

  .image-loader__mark {
    width: 3.375rem;
    height: 5.222rem;
    display: block;
    animation: image-loader-breathe var(--duration-default-double) var(--cubic-default)
      infinite alternate;
  }

  @keyframes image-loader-breathe {
    from {
      opacity: 0.45;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .image-loader__stage {
      transition: none;
    }

    .image-loader__mark {
      animation: none;
      opacity: 1;
    }
  }
</style>

<script>
  const initialized = new WeakSet<HTMLElement>();

  function prefersReducedMotion(): boolean {
    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  }

  function reveal(root: HTMLElement) {
    if (root.dataset.imageLoaderState === "done") return;

    if (prefersReducedMotion()) {
      root.dataset.imageLoaderState = "done";
      return;
    }

    root.dataset.imageLoaderState = "ready";

    const stage = root.querySelector<HTMLElement>("[data-image-loader-stage]");
    if (!stage) {
      root.dataset.imageLoaderState = "done";
      return;
    }

    const finish = (event?: TransitionEvent) => {
      if (event && event.propertyName !== "opacity") return;
      root.dataset.imageLoaderState = "done";
    };

    stage.addEventListener("transitionend", finish, { once: true });
    // Safety if transitionend never fires (display none, tab background).
    window.setTimeout(() => finish(), 500);
  }

  function initOne(root: HTMLElement) {
    if (initialized.has(root)) return;
    initialized.add(root);

    const img = root.querySelector<HTMLImageElement>("[data-image-loader-img]");
    if (!img) {
      reveal(root);
      return;
    }

    const controller = new AbortController();
    const { signal } = controller;

    const onReady = () => {
      reveal(root);
      controller.abort();
    };

    // Cached / already decoded — skip the stage without waiting for a load event.
    if (img.complete && img.naturalWidth > 0) {
      onReady();
      return;
    }

    img.addEventListener("load", onReady, { once: true, signal });
    img.addEventListener("error", onReady, { once: true, signal });

    root.addEventListener("image-loader:destroy", () => controller.abort(), {
      signal,
    });
  }

  function initAll() {
    document
      .querySelectorAll<HTMLElement>("[data-image-loader]")
      .forEach((root) => initOne(root));
  }

  initAll();
  document.addEventListener("astro:page-load", initAll);
</script>
