---
/**
 * ImageLoader
 * Photo frame with the Figma palm loading stage (`242:21`): a canvas surface
 * and centered palm mark sit over the image until it finishes loading, then
 * the stage fades out. Use anywhere an optimized (or remote) image needs a
 * branded placeholder — project galleries, cards, heroes below the fold.
 *
 * Accessibility: the stage is aria-hidden decorative chrome; the real <img>
 * carries alt. Reduced-motion skips the fade. Without JS, a <noscript> rule
 * hides the stage so the image stays visible.
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  /** Imported asset (optimized via astro:assets) or a remote/CMS URL string. */
  src: ImageMetadata | string;
  /** Accessible description. Pass "" only for decorative images. */
  alt: string;
  /** Responsive srcset widths — ImageMetadata only. */
  widths?: number[];
  /** sizes attribute paired with widths. */
  sizes?: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  decoding?: "async" | "sync" | "auto";
  /**
   * When true, sets `aspect-ratio` from ImageMetadata so the frame reserves
   * space before decode. Set false when a parent already owns sizing
   * (e.g. a figure with height + aspect-ratio).
   */
  preserveAspect?: boolean;
  /** Extra classes on the frame. */
  class?: string;
  /** Extra classes on the <img>. Defaults to cover-fill. */
  imgClass?: string;
}

const {
  src,
  alt,
  widths,
  sizes,
  loading = "lazy",
  fetchpriority,
  decoding = "async",
  preserveAspect = true,
  class: className,
  imgClass = "absolute inset-0 size-full object-cover",
} = Astro.props;

const isAsset = typeof src !== "string";
const aspectStyle =
  preserveAspect && isAsset
    ? `aspect-ratio: ${src.width} / ${src.height}`
    : undefined;
---

<div
  data-image-loader
  class:list={["image-loader relative overflow-hidden bg-canvas text-fg", className]}
  style={aspectStyle}
>
  {
    isAsset ? (
      <Image
        src={src}
        alt={alt}
        class={imgClass}
        widths={widths}
        sizes={sizes}
        loading={loading}
        fetchpriority={fetchpriority}
        decoding={decoding}
        data-image-loader-img
      />
    ) : (
      <img
        src={src}
        alt={alt}
        class={imgClass}
        loading={loading}
        fetchpriority={fetchpriority}
        decoding={decoding}
        data-image-loader-img
      />
    )
  }

  <div
    class="image-loader__stage absolute inset-0 z-10 flex items-center justify-center bg-canvas"
    data-image-loader-stage
    aria-hidden="true"
  >
    <svg
      class="image-loader__mark"
      xmlns="http://www.w3.org/2000/svg"
      width="54"
      height="84"
      viewBox="0 0 53.862 83.5651"
      fill="none"
      focusable="false"
    >
      <path
