---
/**
 * ImageLoader
 * Photo frame with a secondary-color loading stage: a `bg-secondary/80`
 * surface sits over the image until it finishes loading, then the stage
 * fades out.
 * Use anywhere an optimized (or remote) image needs a branded placeholder —
 * project galleries, cards, heroes below the fold.
 *
 * Accessibility: the stage is aria-hidden decorative chrome; the real <img>
 * carries alt. Reduced-motion skips the fade. Without JS, a <noscript> rule
 * hides the stage so the image stays visible.
 */
import type { ImageMetadata } from "astro";
import OptimizedPicture from "@components/OptimizedPicture.astro";

interface Props {
  /** Imported asset (Sharp at build) or a Sanity CDN URL string. */
  src: ImageMetadata | string;
  /** Accessible description. Pass "" only for decorative images. */
  alt: string;
  /** Intrinsic pixel size — required for remote/CMS URLs (CLS). */
  width?: number;
  /** Intrinsic pixel size — required for remote/CMS URLs (CLS). */
  height?: number;
  /** Responsive srcset widths. */
  widths?: number[];
  /** sizes attribute paired with widths. */
  sizes?: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  decoding?: "async" | "sync" | "auto";
  /**
   * When true, sets `aspect-ratio` from metadata so the frame reserves
   * space before decode. Set false when a parent already owns sizing
   * (e.g. a figure with height + aspect-ratio).
   */
  preserveAspect?: boolean;
  /**
   * Secondary-color overlay while the photo decodes. Set false on the LCP
   * image so the photograph can paint without waiting for the stage to
   * dismiss.
   */
  stage?: boolean;
  /** Sanity LQIP data URL — paints immediately under the photo. */
  placeholder?: string;
  /** Extra classes on the frame. */
  class?: string;
  /** Extra classes on the <img>. Defaults to cover-fill. */
  imgClass?: string;
}

const {
  src,
  alt,
  width,
  height,
  widths,
  sizes,
  loading = "lazy",
  fetchpriority,
  decoding = "async",
  preserveAspect = true,
  stage = true,
  placeholder,
  class: className,
  imgClass = "absolute inset-0 size-full object-cover",
} = Astro.props;

const isAsset = typeof src !== "string";
const remoteWidth = isAsset ? src.width : width;
const remoteHeight = isAsset ? src.height : height;
const frameStyle = [
  preserveAspect && remoteWidth && remoteHeight
    ? `aspect-ratio: ${remoteWidth} / ${remoteHeight}`
    : undefined,
  placeholder
    ? `--image-loader-lqip: url(${JSON.stringify(placeholder)})`
    : undefined,
]
  .filter(Boolean)
  .join("; ");
---

<div
  data-image-loader
  data-image-loader-lqip={placeholder ? "" : undefined}
  class:list={[
    "image-loader relative overflow-hidden",
    !stage && "bg-secondary/80",
    className,
  ]}
  style={frameStyle || undefined}
>
  <OptimizedPicture
    src={src}
    alt={alt}
    width={width}
    height={height}
    class={imgClass}
    widths={widths}
    sizes={sizes}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding={decoding}
    data-image-loader-img
  />

  {stage && (
    <div
      class="image-loader__stage absolute inset-0 z-10 bg-secondary/80"
      data-image-loader-stage
      aria-hidden="true"
    />
  )}
</div>

{/* Without JS the stage would cover the image forever — hide it. */}
<noscript>
  <style>
    [data-image-loader-stage] {
      display: none !important;
    }
  </style>
</noscript>

<style>
  .image-loader[data-image-loader-lqip] {
    background-image: var(--image-loader-lqip);
    background-size: cover;
    background-position: center;
  }

  .image-loader__stage {
    transition: opacity var(--timing-default-half);
  }

  .image-loader[data-image-loader-state="ready"] .image-loader__stage {
    opacity: 0;
    pointer-events: none;
  }

  .image-loader[data-image-loader-state="done"] .image-loader__stage {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .image-loader__stage {
      transition: none;
    }
  }
</style>

<script>
  const initialized = new WeakSet<HTMLElement>();

  function prefersReducedMotion(): boolean {
    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  }

  function reveal(root: HTMLElement) {
    if (root.dataset.imageLoaderState === "done") return;

    if (prefersReducedMotion()) {
      root.dataset.imageLoaderState = "done";
      return;
    }

    root.dataset.imageLoaderState = "ready";

    const stage = root.querySelector<HTMLElement>("[data-image-loader-stage]");
    if (!stage) {
      root.dataset.imageLoaderState = "done";
      return;
    }

    const finish = (event?: TransitionEvent) => {
      if (event && event.propertyName !== "opacity") return;
      root.dataset.imageLoaderState = "done";
    };

    stage.addEventListener("transitionend", finish, { once: true });
    // Safety if transitionend never fires (display none, tab background).
    window.setTimeout(() => finish(), 500);
  }

  function initOne(root: HTMLElement) {
    if (initialized.has(root)) return;
    initialized.add(root);

    if (!root.querySelector("[data-image-loader-stage]")) {
      root.dataset.imageLoaderState = "done";
      return;
    }

    const img = root.querySelector("img");
    if (!img) {
      reveal(root);
      return;
    }

    const controller = new AbortController();
    const { signal } = controller;

    const onReady = () => {
      reveal(root);
      controller.abort();
    };

    // Cached / already decoded — skip the stage without waiting for a load event.
    if (img.complete && img.naturalWidth > 0) {
      onReady();
      return;
    }

    img.addEventListener("load", onReady, { once: true, signal });
    img.addEventListener("error", onReady, { once: true, signal });

    root.addEventListener("image-loader:destroy", () => controller.abort(), {
      signal,
    });
  }

  function initAll() {
    document
      .querySelectorAll<HTMLElement>("[data-image-loader]")
      .forEach((root) => initOne(root));
  }

  initAll();
  document.addEventListener("astro:page-load", initAll);
</script>
