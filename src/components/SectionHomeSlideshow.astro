---
/**
 * SectionHomeSlideshow
 * Full-bleed horizontal project gallery for the homepage. Vertical scroll
 * pins the frame and swipes the track right → left (GSAP ScrollTrigger).
 *
 * Full-bleed by design (no SectionMain column / side rules) so the pin
 * matches the Figma frame edge-to-edge.
 *
 * Reduced motion: no pin/scrub — native horizontal overflow with scroll-snap.
 */
import type { ImageMetadata } from "astro";
import ImageLoader from "@components/ImageLoader.astro";
import { isCmsImage, type CmsImage } from "../lib/cms-image";

export type SlideshowSlide = {
  image: ImageMetadata | CmsImage;
  alt?: string;
  href?: string;
};

interface Props {
  slides: SlideshowSlide[];
  /** Accessible name for the landmark. */
  ariaLabel?: string;
  class?: string;
}

const {
  slides,
  ariaLabel = "Project photographs",
  class: className,
} = Astro.props;
---

{
  /*
   * Full-bleed pin section — allowed deviation from SectionMain: the Figma
   * frame is an edge-to-edge viewport composition; the shared column + side
   * rules would clip the scrub and fight the pin spacer.
   */
}
<section
  id="home-slideshow"
  data-home-slideshow
  aria-label={ariaLabel}
  class:list={["relative bg-canvas text-fg", className]}
>
  <div
    data-home-slideshow-viewport
    class="relative h-svh w-full overflow-hidden"
  >
    <div
      data-home-slideshow-track
      class="flex h-full w-max items-end gap-[clamp(1.25rem,3vw,2.875rem)] px-[clamp(1.25rem,2.5vw,2.125rem)] pb-[clamp(2rem,6vh,4.5rem)] pt-[clamp(4.5rem,12vh,7rem)]"
    >
      {
        slides.map((slide, i) => {
          const alt =
            slide.alt ??
            (isCmsImage(slide.image)
              ? slide.image.alt
              : `Around the Isla project photograph ${i + 1}`);
          const img = (
            <ImageLoader
              src={isCmsImage(slide.image) ? slide.image.src : slide.image}
              alt={alt}
              width={slide.image.width}
              height={slide.image.height}
              class="absolute inset-0 size-full"
              imgClass="absolute inset-0 size-full object-cover transition-[transform,opacity] duration-default group-hover/slide:scale-[1.02] group-focus-visible/slide:scale-[1.02]"
              preserveAspect={false}
              widths={[480, 720, 960, 1200]}
              sizes="(max-width: 768px) 70vw, 42vw"
              loading={i === 0 ? "eager" : "lazy"}
              fetchpriority={i === 0 ? "high" : undefined}
              decoding={i === 0 ? "sync" : "async"}
              stage={i !== 0}
              placeholder={isCmsImage(slide.image) ? slide.image.lqip : undefined}
            />
          );

          return (
            <figure
              data-home-slideshow-slide
              class="relative m-0 h-[min(72svh,47rem)] w-[min(42vw,37.5rem)] shrink-0 overflow-hidden"
            >
              {slide.href ? (
                <a
                  href={slide.href}
                  class="group/slide absolute inset-0 block outline-none focus-visible:ring-2 focus-visible:ring-focus focus-visible:ring-offset-2 focus-visible:ring-offset-canvas"
                  aria-label={`Open project for photograph ${i + 1}`}
                >
                  {img}
                </a>
              ) : (
                img
              )}
            </figure>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  /* Reduced-motion / no-JS fallback: let the strip scroll natively. */
  @media (prefers-reduced-motion: reduce) {
    [data-home-slideshow-viewport] {
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
    }

    [data-home-slideshow-track] {
      /* Cancel any leftover GSAP transform if motion preference flips mid-session. */
      transform: none !important;
    }

    [data-home-slideshow-slide] {
      scroll-snap-align: start;
      width: min(70vw, 22rem);
    }

    [data-home-slideshow-veil] {
      display: none;
    }
  }
</style>

<script>
  const initialized = new WeakSet<HTMLElement>();
  const controllers = new WeakMap<HTMLElement, AbortController>();
  const triggers = new WeakMap<HTMLElement, { kill: () => void }>();

  let gsap: any;
  let ScrollTrigger: any;

  async function ensureGsap() {
    if (gsap && ScrollTrigger) return;
    gsap = (await import("gsap")).default;
    ScrollTrigger = (await import("gsap/ScrollTrigger")).ScrollTrigger;
    gsap.registerPlugin(ScrollTrigger);
  }

  function prefersReducedMotion() {
    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  }

  function teardown(root: HTMLElement) {
    controllers.get(root)?.abort();
    controllers.delete(root);
    triggers.get(root)?.kill();
    triggers.delete(root);
    const track = root.querySelector<HTMLElement>(
      "[data-home-slideshow-track]",
    );
    if (track && gsap) gsap.set(track, { clearProps: "transform" });
  }

  async function initOne(root: HTMLElement) {
    if (initialized.has(root)) return;
    initialized.add(root);

    const viewport = root.querySelector<HTMLElement>(
      "[data-home-slideshow-viewport]",
    );
    const track = root.querySelector<HTMLElement>(
      "[data-home-slideshow-track]",
    );
    if (!viewport || !track) return;

    if (prefersReducedMotion()) return;

    await ensureGsap();

    const controller = new AbortController();
    controllers.set(root, controller);
    const { signal } = controller;

    const getTravel = () =>
      Math.max(0, track.scrollWidth - viewport.clientWidth);

    const tween = gsap.to(track, {
      x: () => -getTravel(),
      ease: "none",
      scrollTrigger: {
        trigger: root,
        pin: true,
        scrub: 0.45,
        start: "top top",
        end: () => `+=${getTravel()}`,
        invalidateOnRefresh: true,
        anticipatePin: 1,
      },
    });

    if (tween.scrollTrigger) triggers.set(root, tween.scrollTrigger);

    const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
    const onMotionChange = () => {
      if (motionQuery.matches) {
        teardown(root);
        initialized.delete(root);
      }
    };
    motionQuery.addEventListener("change", onMotionChange, { signal });

    // Images can settle layout after decode — refresh pin distances.
    const onLoad = () => ScrollTrigger.refresh();
    root.querySelectorAll("img").forEach((img) => {
      if (!img.complete)
        img.addEventListener("load", onLoad, { signal, once: true });
    });
  }

  function initAll() {
    document
      .querySelectorAll<HTMLElement>("[data-home-slideshow]")
      .forEach((root) => {
        void initOne(root);
      });
  }

  initAll();
  document.addEventListener("astro:page-load", initAll);
</script>
