---
/**
 * Loader — full-viewport intro screen with the centered palm mark.
 *
 * Matches the Figma Loader frame: blank stage, palm centered, then dismisses
 * once hero / above-the-fold images have loaded and decoded (honoring a
 * minimum dwell so it never flashes). Session-skips after the first view so
 * subsequent navigations stay clear.
 *
 * Accessibility: role="status" + live text while visible; inert while covering
 * the page; removed from the tree after exit. Reduced-motion skips the pulse
 * and shortens the exit.
 */
interface Props {
  /**
   * Minimum time the loader stays visible (ms), even if the page is already
   * ready. Defaults to the `--duration-default` token (800ms).
   */
  minDuration?: number;
  /**
   * Show at most once per browser session. Set false to replay on every load
   * (useful in the component showcase).
   */
  oncePerSession?: boolean;
  class?: string;
}

const {
  minDuration = 800,
  oncePerSession = true,
  class: className,
} = Astro.props;
---

{/* Runs before paint so a return visit never flashes the overlay. */}
<script is:inline define:vars={{ sessionKey: "ati-loader-seen", oncePerSession }}>
  try {
    var arrivingCovered =
      document.documentElement.dataset.pageTransitionState === "covered";
    if (
      arrivingCovered ||
      (oncePerSession && sessionStorage.getItem(sessionKey) === "1")
    ) {
      document.documentElement.dataset.loaderSkip = "1";
    }
  } catch {
    /* private mode — show the loader */
  }
</script>

<div
  class:list={[
    "loader fixed inset-0 z-100 flex items-center justify-center bg-panel text-fg",
    className,
  ]}
  data-loader
  data-loader-min={minDuration}
  data-loader-once={oncePerSession ? "true" : "false"}
  role="status"
  aria-live="polite"
  aria-busy="true"
  inert
>
  <span class="sr-only">Loading</span>
  <svg
    class="loader__mark"
    xmlns="http://www.w3.org/2000/svg"
    width="109"
    height="149"
    viewBox="0 0 109 149"
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M83.3566 137.43C88.1505 138.715 95.2529 140.79 94.741 143.685C94.5362 144.83 92.87 145.287 91.6971 144.858L83.8779 141.991L67.6252 137.505C58.0746 134.87 48.645 133.735 38.8245 134.759L21.7713 136.546C16.4747 137.104 11.839 139.692 7.14754 142.438L24.1077 140.865C34.3378 139.915 44.2514 139.171 54.556 139.878C63.3619 140.483 71.5627 142.326 80.1545 144.114C81.1133 144.318 82.0907 145.389 82.1465 146.152C82.2303 147.176 81.0854 148.386 79.9404 148.2L55.0121 144.151C45.9269 143.49 37.1304 143.862 28.1104 144.775L3.79647 147.232C2.68875 147.344 0.836347 146.739 0.389537 145.985C-2.60782 140.995 12.4162 134.014 20.6729 132.394L36.3298 130.691C37.5586 130.56 38.9455 129.946 39.5692 129.099C40.3697 128.01 40.3698 126.455 40.1091 125.013L38.5453 116.328L36.0692 103.687L35.8365 86.5403L37.4189 69.7569C38.0519 63.0827 39.5692 56.2689 42.8551 50.451L49.0826 39.4018L60.4483 23.0839C59.8619 20.9895 58.447 18.4203 56.5201 17.5918C53.4762 16.2793 50.1344 17.8618 47.9097 20.0121L39.141 28.5014L33.258 34.1797C33.0439 34.3938 32.0665 35.0267 31.9176 34.7568L31.0612 33.2488C33.7141 25.2341 38.5546 18.653 45.294 13.8777C49.0453 11.9229 52.6943 10.2846 56.9203 11.0665C58.8193 11.4203 61.1557 12.5373 62.0028 13.887C63.1385 15.7022 63.185 17.9549 62.9523 20.0493C65.7635 19.798 65.0933 11.4761 63.064 9.97743C56.7249 5.30454 44.8751 9.8192 38.4987 14.5852C37.4376 15.3857 36.9908 15.8977 35.3618 16.6982C35.5759 14.52 36.4509 13.0213 37.6982 11.3365L41.2634 6.54258C45.6012 0.696809 55.3007 -1.69548 62.4776 1.28325C66.4151 2.91225 68.4816 6.13299 68.7236 9.96812L69.068 15.3205C71.4417 11.6716 74.1691 8.82318 78.0508 6.96147C83.1053 4.54125 88.4856 2.80056 94.0428 2.1955C97.2357 1.85108 99.5907 2.76333 101.881 4.6995C103.863 6.37504 106.265 7.46414 108.788 8.68356C108.229 9.27 106.395 10.3963 105.381 10.3684C98.7157 10.1729 92.6279 10.8711 86.3819 12.649L78.3486 14.9389C71.9257 16.7634 70.7901 19.7049 72.2143 19.3512L73.4151 19.0533C76.2914 18.3458 79.3726 17.1543 82.4537 17.2102L88.4949 18.532C93.8101 22.4323 97.4591 27.8126 99.0602 34.4124C99.8421 37.6424 98.3992 45.5733 96.8726 44.5866C95.0109 43.3951 93.5495 34.3286 86.838 26.7607C83.8407 23.3817 76.3008 22.3113 70.7342 23.1025L75.8539 27.1424C80.6758 33.3977 81.5322 41.8034 79.1957 49.1664C78.9909 49.7994 77.5202 50.5813 77.2223 50.1159L75.0627 42.1106L72.4936 35.5387L68.9563 27.8219C68.4257 26.6584 66.6571 25.3645 65.3911 25.6996L59.8619 32.4204L49.9948 49.9856C46.7554 55.7569 45.3591 62.3939 44.7075 68.9564L42.79 88.281C42.278 93.3913 43.032 99.0137 44.2235 104.031L46.29 112.735L48.3751 118.562L50.8326 125.282C51.4935 127.079 52.7967 129.201 54.1092 130.495C61.1744 131.324 67.3925 133.148 74.1226 134.954L83.3287 137.43H83.3566Z"
      fill="currentColor"></path>
  </svg>
</div>

{/* Without JS the overlay would trap the page — hide it entirely. */}
<noscript>
  <style>
    [data-loader] {
      display: none !important;
    }
  </style>
</noscript>

<style is:global>
  /* Hide before paint when the inline skip script marked a return visit.
     Namespaced under the html data attribute so it can't leak. */
  html[data-loader-skip] [data-loader] {
    display: none !important;
  }
</style>

<style>
  .loader {
    transition: opacity var(--timing-default-half);
  }

  .loader[data-loader-state="exiting"] {
    opacity: 0;
    pointer-events: none;
  }

  .loader__mark {
    width: 3rem;
    height: auto;
    aspect-ratio: 109 / 149;
    display: block;
    animation: loader-breathe var(--duration-default-double) var(--cubic-default) infinite
      alternate;
  }

  @keyframes loader-breathe {
    from {
      opacity: 0.45;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loader {
      transition: none;
    }

    .loader__mark {
      animation: none;
      opacity: 1;
    }
  }
</style>

<script>
  const SESSION_KEY = "ati-loader-seen";
  /* Safety cap so a hung image request cannot trap the page. Not a motion token. */
  const IMAGE_WAIT_MAX_MS = 8000;
  const initialized = new WeakSet<HTMLElement>();

  function prefersReducedMotion(): boolean {
    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  }

  function isSkippableImage(img: HTMLImageElement): boolean {
    if (img.closest("[hidden]")) return true;
    const src = img.currentSrc || img.src;
    return !src;
  }

  function isAboveFoldImage(img: HTMLImageElement): boolean {
    if (isSkippableImage(img)) return false;
    if (img.hasAttribute("data-loader-wait")) return true;
    if (img.getAttribute("fetchpriority") === "high") return true;

    const rect = img.getBoundingClientRect();
    if (rect.width === 0 && rect.height === 0) return false;
    return (
      rect.top < window.innerHeight &&
      rect.left < window.innerWidth &&
      rect.bottom > 0 &&
      rect.right > 0 &&
      img.getAttribute("loading") !== "lazy"
    );
  }

  async function waitForImage(img: HTMLImageElement): Promise<void> {
    const decode = async () => {
      if (typeof img.decode !== "function") return;
      try {
        await img.decode();
      } catch {
        /* decode rejects on broken images — treat as settled */
      }
    };

    if (img.complete) {
      await decode();
      return;
    }

    await new Promise<void>((resolve) => {
      const done = () => resolve();
      img.addEventListener("load", done, { once: true });
      img.addEventListener("error", done, { once: true });
    });
    await decode();
  }

  function waitWithTimeout(work: Promise<void>, ms: number, signal: AbortSignal): Promise<void> {
    return new Promise((resolve) => {
      let settled = false;
      const finish = () => {
        if (settled) return;
        settled = true;
        window.clearTimeout(timer);
        resolve();
      };
      const timer = window.setTimeout(finish, ms);
      work.then(finish, finish);
      signal.addEventListener("abort", finish, { once: true });
    });
  }

  function waitForDocumentLoad(signal: AbortSignal): Promise<void> {
    if (document.readyState === "complete") return Promise.resolve();
    return new Promise((resolve) => {
      window.addEventListener("load", () => resolve(), { once: true, signal });
    });
  }

  function waitForAboveFoldImages(signal: AbortSignal): Promise<void> {
    const images = Array.from(document.images).filter(isAboveFoldImage);
    if (images.length === 0) return waitForDocumentLoad(signal);
    return waitWithTimeout(
      Promise.all(images.map(waitForImage)).then(() => undefined),
      IMAGE_WAIT_MAX_MS,
      signal,
    );
  }

  function initLoader() {
    document.querySelectorAll<HTMLElement>("[data-loader]").forEach((root) => {
      if (initialized.has(root)) return;
      initialized.add(root);

      if (document.documentElement.dataset.loaderSkip === "1") {
        root.remove();
        return;
      }

      const once = root.dataset.loaderOnce !== "false";
      if (once) {
        try {
          if (sessionStorage.getItem(SESSION_KEY) === "1") {
            root.remove();
            return;
          }
        } catch {
          // sessionStorage can throw in private modes — fall through and show.
        }
      }

      const minDuration = Number(root.dataset.loaderMin ?? "800");
      const startedAt = performance.now();
      const controller = new AbortController();
      const { signal } = controller;
      let finished = false;

      document.documentElement.style.overflow = "hidden";

      const finish = () => {
        if (finished) return;
        finished = true;
        document.documentElement.style.overflow = "";
        root.removeAttribute("aria-busy");
        root.remove();
        controller.abort();
      };

      const dismiss = () => {
        const elapsed = performance.now() - startedAt;
        const wait = Math.max(0, minDuration - elapsed);

        window.setTimeout(() => {
          if (once) {
            try {
              sessionStorage.setItem(SESSION_KEY, "1");
            } catch {
              /* ignore */
            }
          }

          if (prefersReducedMotion()) {
            finish();
            return;
          }

          root.dataset.loaderState = "exiting";
          root.addEventListener(
            "transitionend",
            (event: TransitionEvent) => {
              if (event.propertyName !== "opacity") return;
              finish();
            },
            { signal },
          );
          // Safety if transitionend never fires (display none, tab background).
          window.setTimeout(finish, 500);
        }, wait);
      };

      void waitForAboveFoldImages(signal).then(dismiss);

      root.addEventListener("loader:destroy", () => controller.abort(), { signal });
    });
  }

  initLoader();
  document.addEventListener("astro:page-load", initLoader);
</script>
