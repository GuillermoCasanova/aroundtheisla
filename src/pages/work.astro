---
import Layout from "../layouts/Layout.astro";
import SectionWork from "../components/SectionWork.astro";
import { webPageSchema } from "../lib/schema";

const title = "Work";
const description =
  "Selected photography projects from aroundtheisla — browse the gallery in grid or list view.";

const jsonLd = webPageSchema({
  path: "work",
  title: `${title} — aroundtheisla`,
  description,
});
---

<Layout title={title} description={description} jsonLd={jsonLd} theme="light">
  <main id="main">
    <SectionWork />
  </main>
</Layout>
